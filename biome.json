{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!bun.lock",
			"!!public/precomputed",
			"!!public/models",
			"!!src/data/fluesse.json",
			"!!src/data/roemerstrassen.json",
			"!!src/data/altkarten.json",
			"!!scripts/altkarten/gcp",
			"!!scripts/altkarten/fluesse",
			"!!src/lib/maplibre-version.json"
		],
		"ignoreUnknown": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"suspicious": {
				"noArrayIndexKey": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "asNeeded"
		}
	}
}
