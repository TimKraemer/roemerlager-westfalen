# Vorlage für deploy/deploy.sh. Kopieren nach deploy/deploy.env (nicht
# eingecheckt) und anpassen. Ein vollständiges Beispiel für einen echten
# Server steht in deploy/erleben/deploy.env.

# rsync-Ziel: Host (SSH-Alias oder user@host) und Ordner, den der Webserver
# ausliefert. Der Inhalt des Ordners wird beim Deploy ersetzt.
DEPLOY_TARGET=user@example.org:/var/www/roemer

# Unterpfad, unter dem die App erreichbar ist. Leer lassen für den
# Wurzelpfad (https://example.org/), "/roemer" für https://example.org/roemer/.
BASE_PATH=/roemer

# Öffentliche Adresse, erscheint im Zitiervorschlag
NEXT_PUBLIC_SITE_URL=https://example.org/roemer/

# Eigene Kacheldienste (optional, Standard siehe src/config.js)
# NEXT_PUBLIC_DEM_TILES=https://example.org/dem/{z}/{x}/{y}
# NEXT_PUBLIC_VECTOR_TILES=https://tiles.openfreemap.org/planet/…/{z}/{x}/{y}.pbf
# NEXT_PUBLIC_GLYPHS=https://example.org/font/{fontstack}/{range}
