# Vorlage für lokale Einstellungen. Kopieren nach .env.local (nicht
# eingecheckt). Alle Werte sind optional, die Standards stehen in
# src/config.js. Für den Deploy auf einen Server siehe deploy/deploy.env.example.

# Unterpfad der App, z. B. /roemer. Leer = Wurzelpfad (http://localhost:3000/)
BASE_PATH=

# Öffentliche Adresse für den Zitiervorschlag
# NEXT_PUBLIC_SITE_URL=https://example.org/roemer/

# Kacheldienste (Terrarium-Höhen, OpenMapTiles-Vektorkacheln, Glyphen)
# NEXT_PUBLIC_DEM_TILES=https://example.org/dem/{z}/{x}/{y}
# NEXT_PUBLIC_VECTOR_TILES=https://example.org/tiles/{z}/{x}/{y}
# NEXT_PUBLIC_GLYPHS=https://example.org/font/{fontstack}/{range}

# Ordner mit den Altkarten-Scans für scripts/altkarten/alt.sh
# ALTKARTEN_DIR=$HOME/Downloads/Historische Landkarten
